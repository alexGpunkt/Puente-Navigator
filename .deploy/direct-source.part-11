            "when": "always"
          },
          {
            "no": "13",
            "title": {
              "es": "Werbungskosten superiores al Pauschbetrag / Minijob",
              "de": "Werbungskosten über Pauschbetrag / Minijob"
            },
            "when": "always"
          },
          {
            "no": "14",
            "title": {
              "es": "Gastos de cuidado infantil",
              "de": "Kinderbetreuungskosten"
