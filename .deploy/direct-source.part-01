.upload-zone .upload-icon{font-size:2.2rem}.upload-zone h3{margin:8px 0 4px}.upload-zone p{margin:0;color:var(--muted);font-size:.86rem}
.doc-list{display:grid;gap:10px}.doc-item{background:#fff;border:1px solid var(--line);border-radius:16px;padding:13px}
.doc-item-head{display:flex;gap:10px;align-items:flex-start}.doc-thumb{width:48px;height:48px;border-radius:12px;background:var(--surface2);display:grid;place-items:center;font-size:1.35rem;overflow:hidden;flex:0 0 auto}
.doc-thumb img{width:100%;height:100%;object-fit:cover}.doc-main{flex:1;min-width:0}.doc-main h3{margin:0;font-size:.94rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.doc-main p{margin:3px 0 0;color:var(--muted);font-size:.78rem;line-height:1.35}
.doc-actions{display:flex;gap:6px;flex-wrap:wrap;margin-top:9px}.mini-btn{border:1px solid var(--line);background:#fff;border-radius:9px;padding:6px 8px;font-size:.76rem}.mini-btn.primary{background:var(--accent);color:var(--brand);border-color:#bcd4e6;font-weight:700}.mini-btn.danger{color:var(--bad);background:#fff7f7}
.analysis-bar{height:7px;background:#e7edf2;border-radius:999px;overflow:hidden;margin-top:8px}.analysis-bar span{display:block;height:100%;background:var(--brand2);width:0;transition:width .2s}
.fact-list{display:grid;gap:8px;margin-top:10px}.fact{border:1px solid var(--line);border-radius:13px;padding:10px;background:#fbfdff}.fact.approved{border-color:#9bc9ad;background:#f3fbf6}.fact.rejected{opacity:.5}
.fact-top{display:flex;justify-content:space-between;gap:8px}.fact-label{font-weight:800;font-size:.82rem}.confidence{font-size:.7rem;color:var(--muted)}
.fact input{width:100%;border:1px solid var(--line);border-radius:9px;padding:7px 8px;margin-top:6px;background:#fff}.fact-actions{display:flex;gap:6px;margin-top:7px;flex-wrap:wrap}
.case-fact-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:9px}.case-fact{background:#fff;border:1px solid var(--line);border-radius:14px;padding:11px}.case-fact small{display:block;color:var(--muted);margin-bottom:3px}.case-fact strong{word-break:break-word}
.detect-pill{display:inline-flex;align-items:center;gap:5px;border-radius:999px;padding:4px 8px;background:#eef4f8;color:var(--muted);font-size:.72rem;font-weight:700}.detect-pill.high{background:#e8f6ee;color:var(--ok)}.detect-pill.mid{background:#fff4de;color:var(--warn)}
.manual-text{width:100%;min-height:130px;border:1px solid var(--line);border-radius:13px;padding:10px;background:#fff;resize:vertical}
.local-banner{border:1px solid #b7d4c3;background:#f4fbf6;border-radius:15px;padding:11px;margin:12px 0;font-size:.84rem;line-height:1.4}.local-banner strong{color:var(--ok)}
.case-summary-actions{display:flex;gap:8px;flex-wrap:wrap;margin:12px 0}.hidden-file-input{display:none}
.ocr-note{font-size:.76rem;color:var(--muted);line-height:1.4;margin-top:8px}
.doc-type-select{border:1px solid var(--line);border-radius:9px;padding:6px 8px;background:white;font-size:.78rem;max-width:100%}
.empty-illustration{font-size:2.5rem;margin-bottom:8px}


/* v0.4 – druckfertige Fallakte / Antragssatz */
.dossier-toolbar{position:sticky;top:var(--topbar-h);z-index:8;display:flex;gap:8px;flex-wrap:wrap;padding:10px;background:rgba(244,247,250,.96);border:1px solid var(--line);border-radius:16px;margin-bottom:14px;backdrop-filter:blur(10px)}
.dossier{max-width:850px;margin:0 auto}
.dossier-page{background:#fff;border:1px solid var(--line);border-radius:18px;padding:22px;margin:0 0 14px;box-shadow:var(--shadow)}
.dossier-cover{min-height:620px;display:flex;flex-direction:column;justify-content:space-between}
.dossier-kicker{font-size:.75rem;letter-spacing:.12em;text-transform:uppercase;color:var(--muted);font-weight:800}
.dossier-title{font-size:2rem;line-height:1.08;margin:12px 0 8px;color:var(--brand)}
.dossier-subtitle{font-size:1.05rem;color:var(--muted);line-height:1.45}
.dossier-metrics{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:9px;margin:22px 0}
.metric{border:1px solid var(--line);border-radius:14px;padding:12px;background:#fbfdff}
.metric strong{display:block;font-size:1.35rem;color:var(--brand)}
.metric small{color:var(--muted);font-size:.72rem}
.readiness-ring{width:88px;height:88px;border-radius:50%;display:grid;place-items:center;background:conic-gradient(var(--ok) var(--ready-angle,0deg),#e7edf2 0);position:relative}
.readiness-ring:after{content:"";position:absolute;inset:9px;border-radius:50%;background:white}
.readiness-ring strong{position:relative;z-index:1;font-size:1.15rem;color:var(--brand)}
.cover-status{display:flex;align-items:center;gap:16px;margin:18px 0}
.dossier-section-title{font-size:1.2rem;margin:0 0 12px;color:var(--brand)}
.dossier-table{width:100%;border-collapse:collapse;font-size:.84rem}
.dossier-table th,.dossier-table td{border-bottom:1px solid var(--line);padding:8px 7px;text-align:left;vertical-align:top}
.dossier-table th{font-size:.72rem;text-transform:uppercase;letter-spacing:.03em;color:var(--muted);background:#f7fafc}
.check-row{display:grid;grid-template-columns:28px 1fr auto;gap:9px;align-items:start;padding:9px 0;border-bottom:1px solid var(--line)}
.check-mark{width:22px;height:22px;border-radius:7px;display:grid;place-items:center;font-weight:800;background:#eef2f5;color:var(--muted)}
.check-mark.have{background:#e8f6ee;color:var(--ok)}.check-mark.missing{background:#fdeaea;color:var(--bad)}.check-mark.unsure{background:#fff2d9;color:var(--warn)}
.missing-box{border-left:4px solid var(--bad);background:#fff8f8;border-radius:12px;padding:11px 12px;margin:8px 0}
.missing-box.unsure{border-left-color:var(--warn);background:#fffaf0}
.evidence-item{display:grid;grid-template-columns:48px 1fr auto;gap:10px;align-items:start;padding:10px 0;border-bottom:1px solid var(--line)}
.evidence-no{width:42px;height:34px;border-radius:10px;background:var(--brand);color:#fff;display:grid;place-items:center;font-weight:800}
.evidence-facts{font-size:.76rem;color:var(--muted);margin-top:5px;line-height:1.4}
.appendix-image{max-width:100%;max-height:930px;display:block;margin:12px auto;border:1px solid var(--line);border-radius:8px}
.dossier-foot{font-size:.7rem;color:var(--muted);margin-top:18px;padding-top:8px;border-top:1px solid var(--line)}
.print-only{display:none}
@media(max-width:650px){.dossier-metrics{grid-template-columns:repeat(2,1fr)}.dossier-page{padding:15px}.dossier-title{font-size:1.65rem}.evidence-item{grid-template-columns:42px 1fr}.evidence-item>.badge{grid-column:2}}
@media print{
  @page{size:A4;margin:14mm 13mm 14mm 13mm}
  .topbar,.bottom-nav,.dossier-toolbar{display:none!important}
  body{background:#fff!important;padding:0!important}
  .app-shell{max-width:none!important;width:100%!important;padding:0!important}
  .dossier{max-width:none!important}
  .dossier-page{border:0!important;border-radius:0!important;box-shadow:none!important;margin:0!important;padding:0!important;page-break-after:always;min-height:0}
  .dossier-page:last-child{page-break-after:auto}
  .dossier-cover{min-height:255mm}
  .print-only{display:block}
  .screen-only{display:none!important}
  .appendix-image{max-height:245mm;page-break-inside:avoid}
  a{color:#000;text-decoration:none}
}


/* ========================================================================== 
   v0.4.1 — Mobile-Optimierung, Bedienbarkeit, Kontrast
   Die App wird ueberwiegend unterwegs auf kleinen Android-Geraeten benutzt:
   grosse Tippflaechen, keine iOS-Zoomfallen, korrekte Safe-Areas.
   ========================================================================== */

/* --- Grundlagen ---------------------------------------------------------- */
html{-webkit-text-size-adjust:100%;text-size-adjust:100%}
body{overflow-x:hidden;-webkit-tap-highlight-color:rgba(18,56,91,.12)}
button,a,label,select,summary,[role="button"]{touch-action:manipulation}
p,li,h1,h2,h3,h4,strong,td,th,.card p,.req p,.notice{overflow-wrap:break-word}
img{max-width:100%;height:auto}

/* Sichtbarer Tastaturfokus – vorher gab es gar keinen. */
:focus-visible{outline:3px solid var(--brand2);outline-offset:2px;border-radius:10px}
.skip-link{position:absolute;left:-9999px;top:0;z-index:30;background:var(--brand);color:#fff;
  padding:12px 16px;border-radius:0 0 12px 0;font-weight:700}
.skip-link:focus{left:0}
.sr-only{position:absolute;width:1px;height:1px;margin:-1px;padding:0;overflow:hidden;
  clip:rect(0 0 0 0);clip-path:inset(50%);white-space:nowrap;border:0}

@media (prefers-reduced-motion:reduce){
  *,*::before,*::after{animation-duration:.01ms!important;transition-duration:.01ms!important;scroll-behavior:auto!important}
}

/* --- Tippflaechen: mindestens 44 px, wie von den Plattformrichtlinien empfohlen --- */
.chip,.icon-btn,.ghost-btn,.primary-btn,.secondary-btn,.danger-btn{min-height:var(--tap)}
.status-btn{min-height:var(--tap);padding:8px 12px;font-size:.84rem;flex:1 1 auto;justify-content:center;
  display:inline-flex;align-items:center;gap:4px}
.mini-btn{min-height:40px;padding:9px 12px;font-size:.8rem}
.form-tab{min-height:var(--tap)}
.option-btn{min-height:var(--tap)}
.nav-btn{min-height:var(--tap)}
.doc-type-select{min-height:40px}
.recovery-link{margin-left:0;flex:1 1 100%}

/* --- Eingabefelder: 16 px verhindert das automatische Hineinzoomen unter iOS --- */
input,select,textarea{font-size:16px;max-width:100%}
.session-input,.searchbox,.fact input,.manual-text,.doc-type-select{font-size:16px}
.session-input,.searchbox,.fact input{min-height:var(--tap)}
.searchbox{position:sticky;top:calc(var(--topbar-h) + 4px);z-index:6}

/* --- Kopfzeile: darf auf 320 px nicht umbrechen -------------------------- */
.brand-btn{min-width:0;flex:1 1 auto;min-height:var(--tap)}
.brand-text{min-width:0;overflow:hidden}
.brand-btn strong,.brand-btn small{white-space:nowrap;overflow:hidden;text-overflow:ellipsis;display:block}
.brand-mark{flex:0 0 auto}
.top-actions{flex:0 0 auto}

/* --- Untere Navigation --------------------------------------------------- */
.bottom-nav{padding-left:var(--sal);padding-right:var(--sar);align-items:start}
.nav-btn{padding-top:9px}
.nav-btn small{font-size:.66rem;line-height:1.1;text-align:center;max-width:100%;
  overflow:hidden;text-overflow:ellipsis;white-space:nowrap;padding:0 2px}
.nav-btn.active{position:relative}
.nav-btn.active::before{content:"";position:absolute;top:0;left:22%;right:22%;height:3px;
  border-radius:0 0 4px 4px;background:var(--brand)}

/* --- Dialog: auf kleinen Displays als Bottom-Sheet, Inhalt scrollbar ------ */
.modal{max-height:calc(100dvh - 32px);overscroll-behavior:contain}
.modal-card{display:flex;flex-direction:column;max-height:inherit;gap:10px}
.modal-head{position:sticky;top:0;background:var(--surface);padding-bottom:8px;z-index:1}
.modal-body{overflow-y:auto;-webkit-overflow-scrolling:touch;overscroll-behavior:contain;
  padding-bottom:max(4px,env(safe-area-inset-bottom))}

/* --- Kurze Rueckmeldung statt alert() ------------------------------------ */
.toast{position:fixed;left:50%;transform:translate(-50%,12px);
  bottom:calc(var(--nav-h) + 14px + env(safe-area-inset-bottom));z-index:20;
  background:var(--ink);color:#fff;padding:11px 16px;border-radius:999px;font-size:.86rem;font-weight:600;
  box-shadow:0 10px 30px rgba(0,0,0,.28);opacity:0;transition:opacity .2s,transform .2s;
  max-width:min(90vw,420px);text-align:center}
.toast.show{opacity:1;transform:translate(-50%,0)}

/* --- Karten und Listen: lange Behoerdenwoerter duerfen nichts sprengen ---- */
.card,.req,.doc-item,.form-field,.fact,.notice{min-width:0}
.field-help,.evidence-facts,.case-fact strong,.dossier-table td{overflow-wrap:anywhere}
.doc-main h3{white-space:normal;overflow-wrap:anywhere}
.form-tabs{scrollbar-width:none;-webkit-overflow-scrolling:touch;scroll-snap-type:x proximity;
  overscroll-behavior-x:contain}
.form-tabs::-webkit-scrollbar{display:none}
.form-tab{scroll-snap-align:start}
.upload-zone input{position:absolute;width:1px;height:1px;opacity:0;pointer-events:none}
.upload-zone{display:block;position:relative;cursor:pointer}
.dossier-table{display:block;overflow-x:auto;-webkit-overflow-scrolling:touch}

/* --- Breakpoint: Telefone im Hochformat ---------------------------------- */
@media (max-width:640px){
  .grid{grid-template-columns:1fr}
  .option-grid{grid-template-columns:1fr}
  .case-fact-grid{grid-template-columns:1fr}
  .hero{padding:18px;border-radius:20px}
  .hero h1{font-size:1.4rem}
  .hero-actions .secondary-btn,.hero-actions .primary-btn{flex:1 1 100%;justify-content:center}
  .doc-item-head{align-items:flex-start}
  .upload-zone{padding:16px}
  .service-head .big-icon{font-size:1.9rem}
  .service-head h1{font-size:1.25rem}
  .section-title{margin-top:18px}
  /* Werkzeugleisten: volle Breite statt gequetschter Reihe */
  .toolbar>button,.toolbar>a,.case-summary-actions>button,.wizard-actions>button,
  .dossier-toolbar>button{flex:1 1 100%;text-align:center}
  .toolbar,.case-summary-actions{gap:8px}
  .req-actions{gap:8px}
  .req-actions .status-btn{flex:1 1 0;min-width:88px}
  .doc-actions>*{flex:1 1 100%}
  .fact-actions>button{flex:1 1 0}
  .check-row{grid-template-columns:26px 1fr;row-gap:4px}
  .check-row>.badge{grid-column:2;justify-self:start}
  .evidence-item{grid-template-columns:42px 1fr;row-gap:4px}
  .evidence-item>.badge{grid-column:2;justify-self:start}
  .dossier-cover{min-height:auto}
  .cover-status{flex-wrap:wrap;gap:12px}
  .modal{width:100%;max-width:100%;margin:auto auto 0;border-radius:22px 22px 0 0;
    max-height:88dvh}
  .modal-card{padding:16px 16px calc(16px + env(safe-area-inset-bottom))}
  .dossier-toolbar{top:auto;position:static}
}

/* --- Sehr schmale Geraete (320 px) --------------------------------------- */
@media (max-width:360px){
  .brand-btn small{display:none}
  .nav-btn small{font-size:.6rem}
  .nav-btn span{font-size:1.05rem}
  .hero h1{font-size:1.3rem}
  .dossier-metrics{grid-template-columns:1fr 1fr}
  .app-shell{padding-left:max(10px,var(--sal));padding-right:max(10px,var(--sar))}
}

/* --- Querformat mit wenig Hoehe: Kopf- und Fussleiste nicht fixieren ----- */
@media (max-height:460px) and (orientation:landscape){
  .topbar{position:static}
  .searchbox{position:static}
  .bottom-nav{position:static;height:auto;padding-bottom:8px}
  body{padding-bottom:16px}
}

/* --- Dunkler Modus ------------------------------------------------------- */
@media (prefers-color-scheme:dark){
  :root{
    --bg:#0d1620;--surface:#152230;--surface2:#1c2c3c;--ink:#e8eef4;--muted:#9db0c2;
    --brand:#7fb6e2;--brand2:#9ccbf0;--accent:#1b3247;--ok:#5cc48b;--warn:#e0ac52;--bad:#e88b8b;
    --line:#2a3d50;--shadow:0 8px 28px rgba(0,0,0,.4)
  }
  .topbar{background:rgba(21,34,48,.96)}
  .bottom-nav{background:rgba(21,34,48,.97)}
  .brand-mark{background:var(--brand);color:#0d1620}
  .hero{background:linear-gradient(145deg,#14293b,#1d3f5c)}
  .hero p{color:#c9dcec}
  .primary-btn{background:var(--brand);color:#0d1620;border-color:var(--brand)}
  .secondary-btn{background:var(--accent);border-color:#2c4a63;color:var(--brand2)}
  .hero .secondary-btn{background:#1d3348}
  .notice{background:#132534;border-color:#2a4055}
  .notice.warning{background:#2a2113;border-color:#4d3d1c}
  .notice.danger{background:#2c1717;border-color:#523030}
  .card,.req,.progress-box,.question-card,.result-hero,.doc-item,.form-field,.doc-item,
  .source-list a,.step,.metric,.dossier-page,.case-hero{background:var(--surface)}
  .case-hero{background:linear-gradient(145deg,#182735,#12202d)}
  .fact{background:#132030}.fact.approved{background:#13291e;border-color:#2f5c41}
  .upload-zone{background:#132434;border-color:#3a5570}
  .session-input,.searchbox,.fact input,.manual-text,.doc-type-select,.mini-btn,
  .form-tab,.option-btn,.attachment{background:#132030;color:var(--ink)}
  .badge{background:var(--surface2);color:var(--muted)}
  .badge.ok{background:#16301f;color:var(--ok)}
  .badge.warn{background:#33280f;color:var(--warn)}
  .badge.bad{background:#331a1a;color:var(--bad)}
  .danger-btn{background:#2a1717;border-color:#4d2b2b;color:var(--bad)}
  .modal,.modal-head{background:var(--surface);color:var(--ink)}
  .dossier-table th{background:#16283a}
  .readiness-ring:after{background:var(--surface)}
  .toast{background:#e8eef4;color:#0d1620}
  .missing-box{background:#2a1a1a}.missing-box.unsure{background:#2a2313}
  .check-mark{background:#1c2c3c}
  .analysis-bar,.progress-track{background:#22384c}
  .local-banner{background:#132a1e;border-color:#2c5340}
  .privacy-session{border-color:#38506a}
}

/* --- Druck: Ergaenzungen ------------------------------------------------- */
@media print{
  .toast,.skip-link{display:none!important}
  body{padding-bottom:0!important}
}


/* ==========================================================================
   v0.5 – Fristen, Bescheid, Formularbefüllung, Beratung
   ========================================================================== */

/* --- Zähler für knappe Fristen in der Navigation -------------------------- */
.nav-btn.has-badge{position:relative}
.nav-btn.has-badge::after{content:attr(data-badge);position:absolute;top:4px;left:calc(50% + 6px);
  min-width:18px;height:18px;padding:0 5px;border-radius:999px;background:var(--bad);color:#fff;
  font-size:.66rem;font-weight:800;display:grid;place-items:center;line-height:1}

/* --- Fristenliste --------------------------------------------------------- */
.deadline-list{display:grid;gap:10px}
.deadline{background:var(--surface);border:1px solid var(--line);border-left:5px solid var(--muted);
  border-radius:16px;padding:13px}
.deadline.overdue{border-left-color:var(--bad);background:#fff7f7}
.deadline.urgent{border-left-color:var(--bad)}
.deadline.soon{border-left-color:var(--warn)}
.deadline.ok{border-left-color:var(--ok)}
.deadline.done{opacity:.55;border-left-color:var(--line)}
.deadline-head{display:flex;gap:11px;align-items:flex-start}
.deadline-icon{font-size:1.5rem;line-height:1;flex:0 0 auto}
.deadline-main{flex:1;min-width:0}
