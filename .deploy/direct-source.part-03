kground:var(--surface);border:1px solid var(--line);border-left:5px solid var(--line);
  border-radius:16px;padding:14px}
.deadline.over{border-left-color:var(--bad);background:#fff7f7}
.deadline.critical{border-left-color:var(--bad)}
.deadline.soon{border-left-color:var(--warn)}
.deadline.later{border-left-color:var(--brand2)}
.deadline.done{opacity:.6;border-left-color:var(--ok)}
.deadline-head{display:flex;gap:11px;align-items:flex-start}
.deadline-icon{font-size:1.5rem;line-height:1;flex:0 0 auto}
.deadline-main{flex:1;min-width:0}
.deadline-main h3{margin:0 0 3px;font-size:1rem;overflow-wrap:anywhere}
.deadline-date{font-size:.9rem}
.deadline.over .deadline-date strong,.deadline.critical .deadline-date strong{color:var(--bad)}
.deadline.soon .deadline-date strong{color:var(--warn)}
.deadline-basis{font-size:.72rem;color:var(--muted);margin-top:4px;font-variant-numeric:tabular-nums}
.deadline-actions{display:flex;gap:7px;flex-wrap:wrap;margin-top:11px}

/* --- Fristberechnung: Zwischenschritte sichtbar machen ------------------- */
.calc-box{border:1px dashed var(--line);border-radius:14px;padding:12px;margin:12px 0;background:var(--surface2)}
.calc-steps{display:grid;gap:5px;font-size:.82rem}
.calc-steps>div{display:flex;justify-content:space-between;gap:10px}
.calc-steps span{color:var(--muted)}
.calc-result{margin-top:9px;padding-top:9px;border-top:1px solid var(--line);font-size:.95rem}
.calc-result strong{color:var(--brand)}

/* --- Bescheid-Auswertung innerhalb der Dokumentkarte -------------------- */
.notice-panel{border:1px solid var(--line);border-left:5px solid var(--brand2);border-radius:14px;
  padding:12px;margin-top:11px;background:var(--surface2)}
.notice-panel.aufhebung,.notice-panel.ablehnung{border-left-color:var(--bad)}
.notice-panel.bewilligung{border-left-color:var(--ok)}
.notice-panel-head{display:flex;align-items:center;justify-content:space-between;gap:8px;
  flex-wrap:wrap;margin-bottom:9px}
.notice-panel .dossier-table{margin-bottom:4px}

/* --- Formularbefüllung --------------------------------------------------- */
.step-list{margin:12px 0;padding-left:22px;line-height:1.5;font-size:.9rem}
.step-list li{margin-bottom:5px}
.map-list{display:grid;gap:9px}
.map-row{background:var(--surface);border:1px solid var(--line);border-radius:13px;padding:11px}
.map-field{font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:.76rem;
  color:var(--muted);margin-bottom:6px;overflow-wrap:anywhere}
.map-select{width:100%;border:1px solid var(--line);border-radius:10px;padding:10px;background:var(--surface)}
.checkline{display:flex;align-items:center;gap:9px;font-size:.86rem;margin:8px 2px;line-height:1.35}
.checkline input{width:22px;height:22px;flex:0 0 auto}

/* --- Beratung ------------------------------------------------------------ */
.advice-card .req-actions{gap:8px}
.advice-card .req-actions .secondary-btn{flex:1 1 auto;text-align:center;text-decoration:none}
.prep-list{margin:0;padding-left:20px;display:grid;gap:8px;font-size:.9rem;line-height:1.45}

/* --- "Mehr"-Auswahl ------------------------------------------------------ */
.more-list{display:grid;gap:8px}
.more-item{display:flex;align-items:center;gap:12px;text-align:left;width:100%;
  border:1px solid var(--line);background:var(--surface);border-radius:14px;padding:13px;
  color:var(--ink);min-height:var(--tap)}
.more-item strong{display:block;font-size:.96rem}
.more-item small{display:block;color:var(--muted);font-size:.79rem;line-height:1.35;margin-top:2px}
.more-icon{font-size:1.5rem;flex:0 0 auto}

/* --- Formularelemente in Dialogen --------------------------------------- */
.field-label{display:block;font-weight:700;font-size:.84rem;margin:12px 0 5px}
.full-input{width:100%;border:1px solid var(--line);border-radius:12px;padding:11px;
  background:var(--surface);color:var(--ink);min-height:var(--tap)}

@media (max-width:640px){
  .deadline-actions>button{flex:1 1 calc(50% - 4px)}
  .advice-card .req-actions .secondary-btn{flex:1 1 100%}
  .calc-steps>div{flex-direction:column;gap:1px}
  .calc-steps>div strong{align-self:flex-start}
}

@media (prefers-color-scheme:dark){
  .deadline,.map-row,.more-item,.full-input,.map-select{background:var(--surface)}
  .deadline.over{background:#2a1a1a}
  .calc-box,.notice-panel{background:#132030}
}

@media print{
  .deadline-actions,.map-list,.more-list{display:none!important}
}


/* ========================================================================== 
   v0.6 – Nächster Schritt, Phasen, Speicherstufen, Sprache, Postausgang
   ========================================================================== */

/* --- Startseite: eine Empfehlung statt Kachelwand ----------------------- */
.next-step{text-align:left;position:relative}
.next-step .next-icon{font-size:2.2rem;line-height:1;margin-bottom:8px}
.next-step h1{font-size:1.35rem;margin:0 0 6px}
.next-step p{margin:0 0 14px}
.next-step .next-cta{width:100%;justify-content:center}
.next-step.danger{background:linear-gradient(145deg,#7d2b2b,#a33a3a)}
.next-step.ok{background:linear-gradient(145deg,#1c5b3d,#24784f)}
.next-step.danger .next-cta,.next-step.ok .next-cta,.next-step.brand .next-cta{
  background:#fff;color:var(--brand);border-color:#fff}

/* --- Phasenleiste -------------------------------------------------------- */
.phase-bar{display:grid;grid-template-columns:repeat(3,1fr);gap:6px;margin:14px 0;
  background:var(--surface2);border:1px solid var(--line);border-radius:14px;padding:5px}
.phase{display:flex;flex-direction:column;align-items:center;gap:2px;padding:9px 4px;
  border:0;background:transparent;border-radius:10px;color:var(--muted);min-height:var(--tap)}
.phase small{font-size:.72rem;line-height:1.1;text-align:center}
.phase span{font-size:1.1rem}
.phase.active{background:var(--surface);color:var(--brand);font-weight:700;box-shadow:var(--shadow)}

/* --- Speicherstufen ------------------------------------------------------ */
.mode-list{display:grid;gap:8px}
.mode-item{display:flex;align-items:center;gap:12px;text-align:left;width:100%;
  border:1px solid var(--line);background:var(--surface);border-radius:14px;padding:13px;
  color:var(--ink);min-height:var(--tap)}
.mode-item.active{border-color:var(--brand);box-shadow:0 0 0 2px rgba(18,56,91,.12)}
.mode-item strong{display:block;font-size:.96rem}
.mode-item small{display:block;color:var(--muted);font-size:.79rem;line-height:1.35;margin-top:2px}
.mode-check{margin-left:auto;color:var(--brand);font-weight:800;font-size:1.1rem}

/* --- Speicherwarnung ----------------------------------------------------- */
.storage-alert{margin-bottom:14px}
.fail-pre{white-space:pre-wrap;font-size:.7rem;background:var(--surface2);border-radius:10px;
  padding:10px;margin-top:10px;overflow-x:auto;max-height:200px}

/* --- Vorlesen ------------------------------------------------------------ */
#readBtn.speaking{background:var(--brand);color:#fff;border-color:var(--brand)}
.dictate-q{font-weight:750;font-size:1rem;margin:0 0 4px}
.dictate-live{min-height:52px;border:1px dashed var(--line);border-radius:12px;padding:11px;
  background:var(--surface2);font-size:.9rem;margin:10px 0;overflow-wrap:anywhere}

/* --- Postausgang --------------------------------------------------------- */
.outbox-item{background:var(--surface);border:1px solid var(--line);border-left:5px solid var(--line);
  border-radius:16px;padding:14px}
.outbox-item.best{border-left-color:var(--ok)}
.outbox-item.ok{border-left-color:var(--warn)}
.outbox-item.weak{border-left-color:var(--bad)}

@media (max-width:640px){
  .next-step h1{font-size:1.25rem}
  .mode-item{align-items:flex-start}
  .mode-check{align-self:center}
}

@media (prefers-color-scheme:dark){
  .mode-item,.outbox-item{background:var(--surface)}
  .phase-bar{background:#132030}
  .phase.active{background:var(--surface2)}
  .dictate-live,.fail-pre{background:#132030}
  .next-step.danger{background:linear-gradient(145deg,#4a1f1f,#6b2c2c)}
  .next-step.ok{background:linear-gradient(145deg,#143a29,#1b5138)}
}

@media print{
  .phase-bar,.mode-list,.storage-alert,.next-cta{display:none!important}
}

/* Einwilligungsschalter: Tippfläche auf Plattformmaß bringen */
.consent-row,.checkline{min-height:var(--tap);align-items:center}
.consent-row input[type="checkbox"],.checkline input[type="checkbox"],
#voiceConsent,#pdfFlatten{width:36px;height:36px;flex:0 0 auto;margin:4px 0}
label:has(#voiceConsent){min-height:var(--tap);display:flex;align-items:center;gap:10px}

/* Fallübergabe */
.qr-area{display:flex;justify-content:center;align-items:center;min-height:180px;
  background:var(--surface2);border:1px solid var(--line);border-radius:14px;padding:14px;margin:10px 0}
.qr-area canvas{max-width:100%;height:auto;image-rendering:pixelated;border-radius:8px;background:#fff;padding:8px}


/* ========================================================================== 
   v0.7 – Lokale Karten- und Audioerfassung
   ========================================================================== */
.capture-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;margin:12px 0 14px}
.capture-card{min-width:0;border:1px solid var(--line);border-radius:15px;padding:13px;background:var(--surface2)}
.capture-card strong{display:block;font-size:.94rem;margin-bottom:5px;overflow-wrap:anywhere}
.capture-card p{margin:0 0 11px;color:var(--muted);font-size:.8rem;line-height:1.45;overflow-wrap:anywhere}
.capture-card .secondary-btn{width:100%;justify-content:center;white-space:normal;min-height:var(--tap)}
.local-banner{border:1px solid var(--line);border-left:5px solid var(--ok);border-radius:14px;padding:11px 12px;margin:10px 0 12px;background:var(--surface2);font-size:.84rem;line-height:1.45}
@media(max-width:640px){.capture-grid{grid-template-columns:1fr}.capture-card{padding:12px}}
@media(prefers-color-scheme:dark){.capture-card,.local-banner{background:#132030}}

.capture-actions{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:7px}.capture-actions .danger-btn{grid-column:1/-1;width:100%;justify-content:center}.capture-actions button{white-space:normal;min-height:var(--tap)}
@media(max-width:390px){.capture-actions{grid-template-columns:1fr}}
__PUENTE_FILE_03_EOF__
cat > storage.js <<'__PUENTE_FILE_04_EOF__'
/* Puente v0.6 – Speichermodell

   Drei Stufen, weil aufsuchende Arbeit und geteilte Geräte
   gegensätzliche Anforderungen haben:

     session  Voreinstellung. Persönliche Daten leben nur im Tab und sind
              beim Schließen weg. Entspricht dem Verhalten bis v0.5.
     device   Persönliche Daten bleiben in IndexedDB, bis sie gelöscht werden.
              Für das eigene Handy, damit ein Fall über Tage bearbeitbar ist.
     shared   Wie session, zusätzlich automatische Löschung nach Inaktivität.
              Für Beratungs-Tablets und Geräte, die weitergereicht werden.

   Zwei Behälter:
     app       Sprache, Route, Dokumentstatus, Einstellungen. Wenig sensibel,
               immer im localStorage.
     personal  Formularwerte, bestätigte Angaben aus Dokumenten, Fristen,
               Postausgang. Ablageort hängt von der Stufe ab.

   Schreibfehler werden nicht verschluckt. Ein volles Speicherkontingent
   führte bis v0.5 zu stillem Datenverlust; jetzt meldet das Modul den
   Fehler an die App, die eine Warnung anzeigt.                              */

window.PuenteStorage = (function () {
  "use strict";

  const SCHEMA = 6;
  const PREFIX = "puente:v6:";
  const APP_KEY = PREFIX + "app";
  const PERSONAL_KEY = PREFIX + "personal";
  const MODE_KEY = PREFIX + "mode";
  const IDB_NAME = "puente";
  const IDB_STORE = "kv";

  const MODES = ["session", "device", "shared"];
  const IDLE_MS = { shared: 15 * 60 * 1000 };

  const emptyApp = () => ({ schema: SCHEMA, state: {}, settings: {} });
  const emptyPersonal = () => ({
    schema: SCHEMA, formValues: {}, docSession: { docs: [], approvedFacts: {}, ignoredFacts: {} },
    deadlines: [], outbox: [], notes: []
  });

  let mode = "session";
  let app = emptyApp();
  let personal = emptyPersonal();
  let onError = null;
  let onIdleWipe = null;
  let lastError = null;
  let idleTimer = null;
  let flushTimer = null;
  let ready = false;

  /* ---------------------------------------------------------------- IndexedDB */

  function idbOpen() {
    return new Promise((resolve, reject) => {
      if (!("indexedDB" in window)) return reject(new Error("no-idb"));
      const req = indexedDB.open(IDB_NAME, 1);
      req.onupgradeneeded = () => {
        const db = req.result;
        if (!db.objectStoreNames.contains(IDB_STORE)) db.createObjectStore(IDB_STORE);
      };
      req.onsuccess = () => resolve(req.result);
      req.onerror = () => reject(req.error || new Error("idb-open"));
    });
  }
  async function idbGet(key) {
    const db = await idbOpen();
    return new Promise((resolve, reject) => {
      const tx = db.transaction(IDB_STORE, "readonly");
      const r = tx.objectStore(IDB_STORE).get(key);
      r.onsuccess = () => { resolve(r.result); db.close(); };
      r.onerror = () => { reject(r.error); db.close(); };
    });
  }
  async function idbSet(key, value) {
    const db = await idbOpen();
    return new Promise((resolve, reject) => {
      const tx = db.transaction(IDB_STORE, "readwrite");
      tx.objectStore(IDB_STORE).put(value, key);
      tx.oncomplete = () => { resolve(true); db.close(); };
      tx.onerror = () => { reject(tx.error); db.close(); };
    });
  }
  async function idbDel(key) {
    const db = await idbOpen();
    return new Promise((resolve, reject) => {
      const tx = db.transaction(IDB_STORE, "readwrite");
      tx.objectStore(IDB_STORE).delete(key);
      tx.oncomplete = () => { resolve(true); db.close(); };
      tx.onerror = () => { reject(tx.error); db.close(); };
    });
  }

  /* ------------------------------------------------------- Fehlerbehandlung */

  function report(where, err) {
    lastError = {
      where,
      message: String(err && err.message || err),
      quota: /quota|exceeded|full/i.test(String(err && err.name || "") + String(err && err.message || "")),
      at: Date.now()
    };
    try { onError && onError(lastError); } catch (_) {}
    return lastError;
  }

  function safeParse(raw, fallback) {
    if (!raw) return fallback;
    try {
      const v = JSON.parse(raw);
      return (v && typeof v === "object") ? v : fallback;
    } catch (_) { return fallback; }
  }

  /* ------------------------------------------------------------- Migration */

  /** Übernimmt die Stände aus v0.3–v0.5, damit laufende Fälle nicht verloren gehen. */
  function migrateLegacy() {
    let touched = false;
    try {
      const oldState = safeParse(localStorage.getItem("puente-prototype-v3"), null);
      if (oldState && !Object.keys(app.state).length) { app.state = oldState; touched = true; }

      const oldForm = safeParse(sessionStorage.getItem("puente-form-values-v3"), null);
      if (